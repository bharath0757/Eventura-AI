# Eventura AI — Environment Variables
# Copy this file to .env.local and fill in your values.

# Optional Google Gemini API key for live assistance; rule-based fallback works without it.
GEMINI_API_KEY=

# Supported structured-output text model; configurable on the server only.
# Default verified against Google's official model page on 2026-10-24.
# Availability, quotas and billing depend on your account and provider terms.
GEMINI_MODEL=gemini-3.8-flash
